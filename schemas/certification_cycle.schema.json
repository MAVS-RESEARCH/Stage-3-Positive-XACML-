{"$schema": "http://json-schema.org/draft-07/schema#", "description": "Amendment-005 certification cycle record: one frozen revision bound to one fresh three-chair panel with a single sealed outcome.", "properties": {"assessment": {"description": "Tally of the panel against the operative freeze; null until assessed.", "type": ["object", "null"]}, "cycle_id": {"description": "Immutable cycle identifier.", "pattern": "^CERTIFICATION_CYCLE_[0-9]{3}$", "type": "string"}, "decision": {"description": "Sealed outcome; null until decided.", "type": ["object", "null"]}, "panel": {"description": "Exactly three distinct fresh auditor IDs.", "items": {"pattern": "^AUD-C(0[1-9]|1[0-2])$", "type": "string"}, "maxItems": 3, "minItems": 3, "type": "array"}, "revision": {"description": "Frozen semantic revision under certification.", "minimum": 1, "type": "integer"}, "status": {"description": "Lifecycle state.", "enum": ["OPEN_PENDING", "SEALED_PASSED", "SEALED_FAILED_REPAIRABLE", "SEALED_FAILED_IRREDUCIBLE"], "type": "string"}}, "required": ["cycle_id", "revision", "panel", "status"], "title": "CertificationCycle", "type": "object"}