{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mavs-research/pc-xacml-s3plus/model_verdict.schema.json",
  "title": "Amendment-001 cold-model blind adjudication verdict",
  "description": "One independently initialized cold-model adjudication record (AUD-M01/02/03). Qualification is COLD_MODEL_INDEPENDENT; the exact non-exposure declaration is mandatory verbatim. Never described as human adjudication.",
  "type": "object",
  "required": ["verdict_id", "auditor_id", "qualification", "verdicts", "attestation_hash", "declaration", "prompt_sha256", "packet_sha256", "isolation"],
  "additionalProperties": false,
  "properties": {
    "verdict_id": {"type": "string"},
    "auditor_id": {"type": "string", "pattern": "^AUD-M0[1-3]$"},
    "qualification": {"type": "string", "const": "COLD_MODEL_INDEPENDENT"},
    "verdicts": {
      "type": "object",
      "required": ["H", "P_R", "Lambda", "Atom"],
      "additionalProperties": false,
      "properties": {
        "H": {"$ref": "#/$defs/anchorVerdict"},
        "P_R": {"$ref": "#/$defs/anchorVerdict"},
        "Lambda": {"$ref": "#/$defs/anchorVerdict"},
        "Atom": {"$ref": "#/$defs/anchorVerdict"}
      }
    },
    "attestation_hash": {"type": "string", "minLength": 16},
    "declaration": {"type": "string", "const": "I was not supplied an expected touch set, expected freeze signature or K vector, expected classification, desired experiment outcome, or manuscript claim. I made these judgments solely from the contents of the sealed blind packet."},
    "prompt_sha256": {"type": "string", "minLength": 16},
    "packet_sha256": {"type": "string", "minLength": 16},
    "isolation": {
      "type": "object",
      "required": ["fresh_context", "no_prior_experiment_context", "other_outputs_unavailable"],
      "additionalProperties": false,
      "properties": {
        "fresh_context": {"type": "boolean", "const": true},
        "no_prior_experiment_context": {"type": "boolean", "const": true},
        "other_outputs_unavailable": {"type": "boolean", "const": true},
        "provider": {"type": "string"},
        "model_id": {"type": "string"},
        "sampling": {"type": "string"},
        "tools_web_disabled": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "anchorVerdict": {
      "type": "object",
      "required": ["status", "locators"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["FIXED", "PARTIAL", "AMBIGUOUS", "UNSUPPORTED"]},
        "locators": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    }
  }
}
